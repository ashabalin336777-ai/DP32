NEURAL_DEEP_API_KEY=your_token_here
NEURAL_DEEP_BASE_URL=https://api.neuraldeep.ru/v1
MODEL_EXTRACT=qwen2.5-14b-instruct
MODEL_ANALYZE=qwen2.5-32b-instruct
DB_PATH=data/mcu_competitors.db
REPORT_DIR=reports
LOG_DIR=logs
SCRAPE_DELAY_SEC=5
SCRAPE_TIMEOUT_MS=120000
SCRAPE_WARMUP_DELAY_SEC=2.5
SCRAPE_403_BACKOFF_SEC=8
SCRAPE_CACHE_TTL_SEC=86400
SCRAPE_TARGETS_PATH=data/scrape_targets.json
RAW_DIR=data/raw
# Local demo. Compose web service overrides host to 0.0.0.0.
WEB_HOST=127.0.0.1
WEB_PORT=8080
TZ=Europe/Moscow
SCHEDULE_HOUR=3
SCHEDULE_MINUTE=0
PRICE_ADV_THRESHOLD=5.0
PRICE_DIS_THRESHOLD=5.0
# Neural Deep search:web before Playwright. Empty key or SEARCH_WEB=off → scrape_targets.json.
SEARCH_WEB=on
SEARCH_WEB_LIMIT=5
SEARCH_WEB_QUERY={part} {competitor} купить микроконтроллер
# Optional full URL. Empty = {NEURAL_DEEP_BASE_URL}/search/web
NEURAL_DEEP_SEARCH_WEB_URL=
